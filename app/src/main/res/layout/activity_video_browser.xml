<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/video_browser_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_browser_address"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <EditText
                android:id="@+id/video_browser_address"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/white"
                android:textColorHint="@color/bottom_navigation_text_inactive"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/video_browser_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/browser_refresh"
                android:padding="11dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/help"
            android:padding="8dp"
            android:src="@drawable/ic_help" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/video_browser_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/video_browser_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_red"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/video_browser_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/player_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="110dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_noresults" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/browser_no_results_title"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/browser_no_results_message"
                android:textColor="@color/player_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/bottom_navigation_background"
        android:paddingHorizontal="32dp"
        android:paddingVertical="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_browser_download"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_bold"
            android:text="@string/download"
            android:textAllCaps="false"
            android:textSize="24sp"
            app:backgroundTint="@color/brand_red"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_download_btn"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="28dp" />
    </FrameLayout>
</LinearLayout>
