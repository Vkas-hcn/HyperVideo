<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Top chrome: back | address pill | help -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/video_browser_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/back"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_browser_address"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/video_browser_lock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock" />

            <EditText
                android:id="@+id/video_browser_address"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/white"
                android:textColorHint="@color/bottom_navigation_text_inactive"
                android:textCursorDrawable="@drawable/bg_rename_cursor"
                android:textSize="13sp"
                tools:text="tiktok.com/@naturevibes/video/738..." />

            <ImageView
                android:id="@+id/video_browser_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/browser_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <ImageView
            android:id="@+id/video_browser_help"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/help"
            android:padding="4dp"
            android:src="@drawable/ic_help" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/video_browser_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/video_browser_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_red"
            android:visibility="gone" />

        <!-- Empty / error state — centered between top chrome and bottom bar -->
        <LinearLayout
            android:id="@+id/video_browser_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_noresults" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:text="@string/browser_no_results_title"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/browser_no_results_message"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_browser_bottom_bar"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/video_browser_download"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_guide_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download_btn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="@string/download"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
