<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/video_thumbnail"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:background="@color/player_surface"
        android:contentDescription="@string/local_video_title"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="VID_20260101_120000.mp4" />

        <TextView
            android:id="@+id/video_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/player_text_secondary"
            android:textSize="12sp"
            tools:text="03:24 · 48.6 MB" />

    </LinearLayout>

</LinearLayout>
