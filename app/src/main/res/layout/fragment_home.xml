<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="@string/cine"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="@string/flow"
                android:layout_marginStart="6dp"
                android:textColor="@color/brand_red"
                android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_folders"
                style="@style/HomeModeButton"
                android:text="@string/folders" />

            <TextView
                android:id="@+id/tab_videos"
                style="@style/HomeModeButton"
                android:layout_marginStart="10dp"
                android:text="@string/videos" />

            <TextView
                android:id="@+id/tab_shorts"
                style="@style/HomeModeButton"
                android:layout_marginStart="10dp"
                android:text="@string/shorts" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/layout_toggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/layout_toggle"
                android:src="@drawable/ic_layout1" />

            <ImageView
                android:id="@+id/btn_filter"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/filter"
                android:padding="6dp"
                android:src="@drawable/ic_filter"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/permission_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:contentDescription="@string/permission_image_description"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_permissions" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/permission_title"
                        android:textColor="@color/white"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/permission_message"
                        android:textColor="@color/permission_text"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/settings_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/step_one"
                            layout="@layout/item_permission_step" />

                        <include
                            android:id="@+id/step_two"
                            layout="@layout/item_permission_step" />

                        <include
                            android:id="@+id/step_three"
                            layout="@layout/item_permission_step" />

                        <include
                            android:id="@+id/step_four"
                            layout="@layout/item_permission_step" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permission_action"
                        style="@style/PermissionActionButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:text="@string/grant_access" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/local_video_empty"
                android:textColor="@color/permission_text"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/home_native_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
